{
  "ConnectionStrings": {
    "Reclaim": ""
  },
  "Jwt": {
    "Issuer": "reclaim-api",
    "Audience": "reclaim-mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Audit": {
    "IpHashKey": ""
  },
  "AccountDeletion": {
    "GracePeriodDays": 7
  },
  "RateLimiting": {
    "AuthPermitsPerMinutePerIp": 10,
    "RequestsPerMinutePerUser": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
